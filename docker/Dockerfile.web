# Development/Staging Dockerfile for Sentinel NER Next.js Frontend
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY apps/web/package.json ./
RUN npm install

COPY apps/web ./

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npx", "next", "dev", "-p", "3000", "-H", "0.0.0.0"]

